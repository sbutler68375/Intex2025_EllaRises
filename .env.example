# Copy this file to .env and fill in your Supabase "Session pooler" connection details
# (Supabase -> Connect -> Session pooler -> "View parameters").
# Wrap the password in single quotes if it contains # or other special characters.
RDS_HOSTNAME=aws-0-REGION.pooler.supabase.com
RDS_PORT=5432
RDS_USERNAME=postgres.YOUR-PROJECT-REF
RDS_PASSWORD='YOUR-DATABASE-PASSWORD'
RDS_DB_NAME=postgres
DB_SSL=true

# Any long random string (signs login sessions)
SESSION_SECRET=change-me-to-a-long-random-string
PORT=3001
